+async def _safe_answer_callback(query, text: str | None = None, *, show_alert: bool = False) -> bool:
+    """Acknowledge Telegram callback without crashing on expired callback IDs."""
+    if query is None:
+        return False
+    try:
+        await query.answer(text=text, show_alert=show_alert)
+        return True
+    except BadRequest as exc:
+        message = str(exc).lower()
+        if (
+            "query is too old" in message
+            or "response timeout expired" in message
+            or "query id is invalid" in message
+        ):
+            logger.info("Ignoring expired Telegram callback query: %s", exc)
+            return False
+        raise
